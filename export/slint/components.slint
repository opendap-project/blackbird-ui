// SPDX-FileCopyrightText: 2026 The OpenDAP Project
// SPDX-License-Identifier: MPL-2.0
//
// Blackbird UI's components for Slint (ADR 0002): the controls of the design system §15, from
// its tokens, for every OpenDAP application (the product, activities, the shell's layers). Each
// job has its control (§15.2, DS-018). Each component draws itself in two ways on the same
// geometry: as the product, and in the blueprint mode (blueprint.slint, SYS-070), as a technical
// drawing of itself. Import with `import { Button, … } from "@blackbird/slint/components.slint";`.

import { Tokens } from "tokens.slint";
import { Blueprint, Measure, BlueprintGrid, SnapLines } from "blueprint.slint";
export { Blueprint, Measure, BlueprintGrid, SnapLines }

// Whether the focus is shown (CSS :focus-visible, Android's touch mode): the focus is always
// somewhere (focus on entry), but its ring shows only once the buttons or a keyboard are used, and
// hides again when the screen is touched. Touching an element gives it the focus (hidden), so the
// buttons continue from where the finger was; a pointer hovering moves nothing. The first key
// while the focus is hidden only reveals where it is; it neither moves nor takes it.
export global FocusVisible {
    in-out property <bool> on;
}

// Where the focused element is, in window coordinates, so a scrolled screen can bring it into
// view when the buttons move the focus there (focus on entry and focus navigation, §8.4). A
// screen binds `serial` and reveals `y` to `y + h` in its scroll area.
export global FocusReveal {
    in-out property <length> y;
    in-out property <length> h;
    in-out property <int> serial;
}

// The direction the focus last moved in by the keys: Tab (Volume −) forward, Shift+Tab
// (Volume +) backward. A control entered backward starts at its end (a range's high knob, a
// list's last item); taken from the key, never guessed from positions (`Screen` and `Modal`
// record it before the key reaches anything).
export global FocusNav {
    in-out property <bool> backward;
}

// Reduce motion (DS-012): durations become zero, springs settle at once; the application sets it
// from the system's setting.
export global Motion {
    in-out property <bool> reduce;
}

// The layout's direction (§9.5): right to left mirrors start and end, arrows and chevrons;
// transport, the seek bar and the volume do not mirror (physical order).
export global Layout {
    in-out property <bool> rtl;
}

// A touch area that follows the gesture rules (system input events §3.2), for every component
// that acts on a tap: a tap is down and up within the slop before the long-press time; a long
// press fires while the finger is still down and nothing follows on release; a contact that went
// past the slop (a scroll, a drag) is never a tap, even if it comes back. A contact hides the
// focus ring and gives the element the focus (`down`), so the buttons continue from there.
export component TapArea inherits TouchArea {
    // Logical pixels per design pixel, for the slop.
    in property <float> unit: 1.0;
    callback down();
    callback tapped();
    callback long-pressed();
    property <bool> long;
    property <bool> far;
    pointer-event(e) => {
        if e.kind == PointerEventKind.down { root.long = false; root.far = false; FocusVisible.on = false; root.down(); }
        // The system took the contact (input events §5.1): nothing that started acts, and any
        // lock ends with the ring.
        if e.kind == PointerEventKind.cancel { root.long = true; FocusVisible.on = false; }
    }
    moved => {
        if self.pressed && sqrt(pow((self.mouse-x - self.pressed-x) / 1px, 2) + pow((self.mouse-y - self.pressed-y) / 1px, 2)) >= 10 * root.unit { root.far = true; }
    }
    clicked => { if !root.long && !root.far { root.tapped(); } }
    Timer {
        interval: 500ms;
        running: root.pressed && !root.long && !root.far;
        triggered => { root.long = true; root.long-pressed(); }
    }
}

// Colours that follow the mode: the product's, or the blueprint's ink at an opacity level.
export global Ink {
    out property <color> text: Blueprint.on ? Blueprint.ink.with-alpha(Blueprint.text) : Tokens.text-primary;
    out property <color> secondary: Blueprint.on ? Blueprint.ink.with-alpha(Blueprint.secondary) : Tokens.text-secondary;
    out property <color> muted: Blueprint.on ? Blueprint.ink.with-alpha(Blueprint.outline) : Tokens.text-muted;
    out property <color> line: Blueprint.on ? Blueprint.ink.with-alpha(Blueprint.outline) : Tokens.border-base;
    out property <color> ground: Blueprint.on ? Blueprint.paper : Tokens.bg;
}

// The ground of a screen; in the blueprint mode, the paper and its 8 px grid (the shell draws
// the snap lines over it). It also takes what the focused element leaves (system input events
// §4.2, design system §8.4), as the bubble phase does:
// - Action (Enter, Space) while the focus is hidden: the screen's primary action where it
//   declares one (`has-primary`, T1-061); else it only reveals the focus. With the focus shown,
//   the focused element takes Action itself.
// - Escape: back, where there is a way back (`can-back`).
// - A touch on its bare ground hides the focus ring, as a touch anywhere does.
// - The ends: Volume past the first or the last element stays there (system input events §3.7;
//   only a modal wraps). Slint's chain wraps around the window, so an invisible stop sits at each
//   end; when it takes the focus, `edge(end)` asks the runtime to send the opposite key, which
//   gives the focus back to the element at that end (a Slint gap, ui-model §6.3).
export component Screen inherits Rectangle {
    in property <float> unit: 1.0;
    in property <bool> has-primary;
    in property <bool> can-back;
    callback primary();
    callback back();
    // `end` true: past the last element; false: before the first.
    callback edge(bool);
    background: Ink.ground;
    if Blueprint.on: BlueprintGrid { step: 8px * root.unit; alpha: Blueprint.grid-minor; }
    FocusScope {
        width: 0;
        height: 0;
        focus-on-click: false;
        focus-gained(reason) => { if reason == FocusReason.tab-navigation { root.edge(false); } }
    }
    // It only receives what bubbles up: never focused itself, by Tab or by touch.
    FocusScope {
        focus-on-tab-navigation: false;
        focus-on-click: false;
        // Before any element sees it: the direction a Tab moves the focus in.
        capture-key-pressed(e) => {
            if e.text == Key.Tab || e.text == Key.Backtab {
                FocusNav.backward = e.text == Key.Backtab || e.modifiers.shift;
            }
            reject
        }
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " {
                if root.has-primary && !FocusVisible.on { root.primary(); } else { FocusVisible.on = true; }
                return accept;
            }
            if e.text == Key.Escape && root.can-back { root.back(); return accept; }
            reject
        }
        TouchArea { pointer-event(e) => { if e.kind == PointerEventKind.down { FocusVisible.on = false; } } }
        @children
    }
    // The end stops, outside the content so the chain runs: start, the content, end.
    FocusScope {
        width: 0;
        height: 0;
        focus-on-click: false;
        focus-gained(reason) => { if reason == FocusReason.tab-navigation { root.edge(true); } }
    }
}

// Text in its roles (§9.1): `title`, `body`, `label`, `caption`; `mono` for values (§15).
export component Label inherits Text {
    in property <string> role: "body";
    in property <bool> mono;
    in property <bool> muted;
    font-family: root.mono ? Tokens.font-family-mono : Tokens.font-family-ui;
    font-size: root.role == "title" ? Tokens.font-size-title : (root.role == "label" ? Tokens.font-size-label : (root.role == "caption" ? Tokens.font-size-caption : Tokens.font-size-body));
    font-weight: root.role == "title" ? Tokens.font-weight-semibold : Tokens.font-weight-regular;
    color: root.muted ? Ink.secondary : Ink.text;
    wrap: word-wrap;
}

// A screen's header: back (when the screen has somewhere to go back to) and its title.
export component Header inherits Rectangle {
    in property <string> title;
    in property <bool> can-back: true;
    in property <float> unit: 1.0;
    callback back();
    height: Tokens.size-header;
    // Focus on entry lands on the way back when the screen has nothing else first.
    public function focus-back() { if root.can-back { back-fs.focus(); } }
    HorizontalLayout {
        padding-right: Tokens.space-margin;
        padding-left: root.can-back ? 0 : Tokens.space-margin;
        spacing: Tokens.space-unit;
        if root.can-back: Rectangle {
            width: Tokens.size-target-min;
            accessible-role: button;
            accessible-label: "Back";
            accessible-action-default => { root.back(); }
            background: back-touch.pressed ? (Blueprint.on ? Blueprint.live.with-alpha(0.2) : Tokens.surface-active) : transparent;
            border-width: Blueprint.on ? 1px : 0;
            border-color: back-touch.pressed ? Blueprint.live : Blueprint.interactive.with-alpha(back-touch.has-hover ? 0.9 : 0.35);
            // A chevron, as the icon set draws it (2 px, round ends).
            Path {
                width: 24px;
                height: 24px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: Layout.rtl ? "M 9 6 L 15 12 L 9 18" : "M15 6 L9 12 L15 18";
                stroke: Ink.text;
                stroke-width: 2px;
                stroke-line-cap: round;
                stroke-line-join: round;
                fill: transparent;
            }
            Measure { width: parent.width; height: parent.height; shown: back-touch.has-hover || back-touch.pressed; unit: root.unit; }
        }
        Label { role: "title"; text: root.title; vertical-alignment: center; wrap: no-wrap; overflow: elide; }
    }
    if Blueprint.on: Rectangle { y: parent.height - 1px; height: 1px; background: Ink.line; }
    // The way back takes the focus as any other control (focus on entry, design system §8.4).
    // One area takes the touch and the focus: the focus scope holds the touch area, so a tap
    // goes back instead of only focusing. Nothing of it exists where there is no way back.
    back-fs := FocusScope {
        x: 0;
        width: root.can-back ? Tokens.size-target-min : 0;
        // Out of the focus chain where there is no way back. Never disabled or hidden while it may
        // hold the focus: Slint then keeps its `has-focus` after the focus moves on, and its ring
        // stayed on the next screen.
        focus-on-tab-navigation: root.can-back;
        focus-on-click: root.can-back;
        // Like every focusable element, it says where it is, so the next one knows from which
        // side the focus came (a range or a list entered from below starts at its end).
        changed has-focus => {
            if self.has-focus {
                FocusReveal.y = root.absolute-position.y;
                FocusReveal.h = root.height;
                FocusReveal.serial += 1;
            }
        }
        key-pressed(e) => {
            // Hidden focus: a navigation key only reveals it; Action and Escape go to the screen.
            if !FocusVisible.on { if e.text == Key.Return || e.text == " " || e.text == Key.Escape { return reject; } FocusVisible.on = true; return accept; }
            if e.text == Key.Return || e.text == " " { root.back(); return accept; }
            reject
        }
        back-touch := TapArea {
        unit: root.unit; down => { back-fs.focus(); } enabled: root.can-back; tapped => { root.back(); } }
    }
    if root.can-back && back-fs.has-focus && FocusVisible.on: Rectangle { x: 0; width: Tokens.size-target-min; border-width: 2px; border-color: Tokens.focus; }
}

// A secondary action (§15): a graphite surface with its label; in blueprint, its outline.
export component Button inherits Rectangle {
    in property <string> label;
    in property <float> unit: 1.0;
    in property <bool> enabled: true;
    // Why it is disabled (ADR 0003): shown to the screen reader, and it disables the button.
    in property <string> reason;
    // No fill at rest (an action inside a toast); the press and the hover still show.
    in property <bool> quiet;
    property <bool> live: root.enabled && root.reason == "";
    callback clicked();
    // The touch minimum (§8.3) as the default; a screen may give it more.
    height: Tokens.size-target-min;
    border-radius: Tokens.radius-control;
    border-width: 1px;
    border-color: Blueprint.on
        ? (touch.pressed ? Blueprint.live : Blueprint.interactive.with-alpha(touch.has-hover ? 0.9 : 0.6))
        : Tokens.border-base;
    background: Blueprint.on
        ? (touch.pressed ? Blueprint.live.with-alpha(0.2) : Blueprint.interactive.with-alpha(touch.has-hover ? 0.1 : 0))
        : (touch.pressed ? Tokens.surface-active : (touch.has-hover ? Tokens.surface-raised.brighter(8%) : (root.quiet ? transparent : Tokens.surface-raised)));
    opacity: root.live ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.live;
    accessible-description: root.reason;
    accessible-action-default => { if root.live { root.clicked(); } }
    HorizontalLayout {
        padding-left: Tokens.space-group;
        padding-right: Tokens.space-group;
        Label { role: "label"; text: root.label; horizontal-alignment: center; vertical-alignment: center; wrap: no-wrap; overflow: elide; }
    }
    // Focusable (focus on entry, design system §8.4): Enter or Space takes it; the ring shows it.
    forward-focus: fs;
    fs := FocusScope {
        // Disabled is skipped by the buttons and a touch (input events §3.7): it keeps its place
        // and its reason shows, but takes no focus.
        focus-on-tab-navigation: root.live;
        focus-on-click: root.live;
        changed has-focus => {
            if self.has-focus {
                FocusReveal.y = root.absolute-position.y;
                FocusReveal.h = root.height;
                FocusReveal.serial += 1;
            }
        }
        key-pressed(e) => {
            // Hidden focus: a navigation key only reveals it; Action and Escape go to the screen.
            if !FocusVisible.on { if e.text == Key.Return || e.text == " " || e.text == Key.Escape { return reject; } FocusVisible.on = true; return accept; }
            if e.text == Key.Return || e.text == " " { if root.live { root.clicked(); } return accept; }
            reject
        }
    }
    if fs.has-focus && FocusVisible.on: Rectangle { border-radius: root.border-radius; border-width: 2px; border-color: Tokens.focus; }
    touch := TapArea {
        unit: root.unit; down => { fs.focus(); } enabled: root.live; tapped => { root.clicked(); } }
    Measure { width: parent.width; height: parent.height; shown: touch.has-hover || touch.pressed; unit: root.unit; }
}

// The screen's one primary action (§15): orange, round, 64 px, dark label on the fill; in
// blueprint, its outline in the accent.
// Its shape follows its content (§15): a word makes a full-width capsule; an icon alone (with
// its accessible `label` as `name`) makes a 64 px circle.
export component PrimaryButton inherits Rectangle {
    in property <bool> enabled: true;
    // Why it is disabled (ADR 0003): shown to the screen reader, and it disables the control.
    in property <string> reason;
    property <bool> live: root.enabled && root.reason == "";
    in property <string> label;
    in property <image> icon;
    // The accessible name when it shows an icon only.
    in property <string> name;
    in property <float> unit: 1.0;
    callback clicked();
    // Focus on entry (design system §8.4): a screen's primary action takes the focus when the
    // screen arrives, whatever comes before it; without one, the first element does. Off for a
    // primary-styled control that is not the screen's primary action (a catalogue of them).
    in property <bool> default-focus: true;
    init => { if root.default-focus { fs.focus(); } }
    property <bool> round: root.label == "" && root.icon.width > 0;
    height: Tokens.size-target-primary;
    min-width: self.height;
    max-width: root.round ? self.height : 100000px;
    horizontal-stretch: root.round ? 0 : 1;
    border-radius: self.height / 2;
    border-width: Blueprint.on ? 1px : 0;
    border-color: Blueprint.on && !touch.pressed ? Blueprint.interactive.with-alpha(touch.has-hover ? 0.9 : 0.6) : Blueprint.live;
    background: Blueprint.on
        ? (touch.pressed ? Blueprint.live.with-alpha(0.2) : Blueprint.interactive.with-alpha(touch.has-hover ? 0.1 : 0))
        : (touch.pressed ? Tokens.brand-pressed : (touch.has-hover ? Tokens.brand-hover : Tokens.brand-base));
    opacity: root.live ? 1 : 0.45;
    accessible-enabled: root.live;
    accessible-description: root.reason;
    accessible-role: button;
    accessible-label: root.round ? root.name : root.label;
    accessible-action-default => { if root.live { root.clicked(); } }
    if root.round: Image {
        source: root.icon;
        width: 32px;
        height: 32px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: Blueprint.on ? Blueprint.ink.with-alpha(Blueprint.text) : Tokens.text-on-brand;
    }
    if !root.round: HorizontalLayout {
        padding-left: Tokens.space-section;
        padding-right: Tokens.space-section;
        Text {
            text: root.label;
            font-family: Tokens.font-family-ui;
            font-size: Tokens.font-size-body-large;
            font-weight: Tokens.font-weight-semibold;
            color: Blueprint.on ? Blueprint.ink.with-alpha(Blueprint.text) : Tokens.text-on-brand;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    // Focusable (focus on entry, design system §8.4): Enter or Space takes it; the ring shows it.
    forward-focus: fs;
    fs := FocusScope {
        // Disabled is skipped by the buttons and a touch (input events §3.7): it keeps its place
        // and its reason shows, but takes no focus.
        focus-on-tab-navigation: root.live;
        focus-on-click: root.live;
        changed has-focus => {
            if self.has-focus {
                FocusReveal.y = root.absolute-position.y;
                FocusReveal.h = root.height;
                FocusReveal.serial += 1;
            }
        }
        key-pressed(e) => {
            // Hidden focus: a navigation key only reveals it; Action and Escape go to the screen.
            if !FocusVisible.on { if e.text == Key.Return || e.text == " " || e.text == Key.Escape { return reject; } FocusVisible.on = true; return accept; }
            if e.text == Key.Return || e.text == " " { if root.live { root.clicked(); } return accept; }
            reject
        }
    }
    if fs.has-focus && FocusVisible.on: Rectangle { border-radius: root.border-radius; border-width: 2px; border-color: Tokens.focus; }
    touch := TapArea {
        unit: root.unit; down => { fs.focus(); } enabled: root.live; tapped => { root.clicked(); } }
    Measure { width: parent.width; height: parent.height; shown: touch.has-hover || touch.pressed; unit: root.unit; }
}

// A list line: go to a thing or a sub-screen; full width, hairline, chevron (§15.2).
export component ListLine inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    // Disabled with its reason (ADR 0003): the line dims and says why; taking it does nothing.
    in property <string> reason;
    // Disabled without a reason of its own (a disabled group says it once, ADR 0003).
    in property <bool> enabled: true;
    property <bool> live: root.enabled && root.reason == "";
    in property <float> unit: 1.0;
    callback clicked();
    height: root.detail == "" && root.reason == "" ? Tokens.size-row : Tokens.size-row-two;
    background: Blueprint.on
        ? (touch.pressed ? Blueprint.live.with-alpha(0.2) : Blueprint.interactive.with-alpha(touch.has-hover ? 0.1 : 0))
        : (!root.live ? transparent : (touch.pressed ? Tokens.surface-active : (touch.has-hover ? Tokens.surface-base : transparent)));
    // In blueprint, the line's interactive area: its outline.
    border-width: Blueprint.on ? 1px : 0;
    border-color: touch.pressed ? Blueprint.live : Blueprint.interactive.with-alpha(touch.has-hover ? 0.9 : 0.35);
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.live;
    accessible-description: root.reason != "" ? root.reason : root.detail;
    accessible-action-default => { if root.live { root.clicked(); } }
    HorizontalLayout {
        padding-left: Tokens.space-margin;
        padding-right: Tokens.space-margin;
        spacing: Tokens.space-unit;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Label { role: "body"; text: root.label; wrap: no-wrap; overflow: elide; opacity: root.live ? 1 : 0.45; }
            if root.detail != "" || root.reason != "": Label { role: "caption"; muted: true; text: root.reason != "" ? root.reason : root.detail; wrap: no-wrap; overflow: elide; }
        }
        Path {
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            viewbox-width: 24;
            viewbox-height: 24;
            // Forward points to the end: mirrored right to left.
            commands: Layout.rtl ? "M15 6 L9 12 L15 18" : "M9 6 L15 12 L9 18";
            stroke: Ink.secondary;
            opacity: root.live ? 1 : 0.45;
            stroke-width: 2px;
            stroke-line-cap: round;
            stroke-line-join: round;
            fill: transparent;
        }
    }
    Rectangle { y: parent.height - Tokens.size-group-divider; height: Tokens.size-group-divider; background: Ink.line; }
    // Focusable (focus on entry, design system §8.4): Enter or Space takes it; the ring shows it.
    forward-focus: fs;
    fs := FocusScope {
        // Disabled is skipped by the buttons and a touch (input events §3.7): it keeps its place
        // and its reason shows, but takes no focus.
        focus-on-tab-navigation: root.live;
        focus-on-click: root.live;
        changed has-focus => {
            if self.has-focus {
                FocusReveal.y = root.absolute-position.y;
                FocusReveal.h = root.height;
                FocusReveal.serial += 1;
            }
        }
        key-pressed(e) => {
            // Hidden focus: a navigation key only reveals it; Action and Escape go to the screen.
            if !FocusVisible.on { if e.text == Key.Return || e.text == " " || e.text == Key.Escape { return reject; } FocusVisible.on = true; return accept; }
            if e.text == Key.Return || e.text == " " { if root.live { root.clicked(); } return accept; }
            reject
        }
    }
    if fs.has-focus && FocusVisible.on: Rectangle { border-radius: 0; border-width: 2px; border-color: Tokens.focus; }
    touch := TapArea {
        unit: root.unit; down => { fs.focus(); } tapped => { if root.live { root.clicked(); } } }
    Measure { width: parent.width; height: parent.height; shown: touch.has-hover || touch.pressed; unit: root.unit; }
}

// A toggle: one setting on or off (§15.2); in blueprint, its track and knob as outlines.
export component Toggle inherits Rectangle {
    in property <string> label;
    in-out property <bool> on;
    // Disabled with its reason (ADR 0003): the switch dims, the reason shows under the label.
    in property <string> reason;
    // Disabled without a reason of its own (a disabled group says it once, ADR 0003).
    in property <bool> enabled: true;
    property <bool> live: root.enabled && root.reason == "";
    in property <float> unit: 1.0;
    callback toggled(bool);
    height: root.reason == "" ? Tokens.size-row : Tokens.size-row-two;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checked: root.on;
    accessible-enabled: root.live;
    accessible-description: root.reason;
    accessible-action-default => { if root.live { root.on = !root.on; root.toggled(root.on); } }
    background: Blueprint.on && touch.pressed ? Blueprint.live.with-alpha(0.2) : (Blueprint.on && touch.has-hover ? Blueprint.interactive.with-alpha(0.1) : transparent);
    border-width: Blueprint.on ? 1px : 0;
    border-color: touch.pressed ? Blueprint.live : Blueprint.interactive.with-alpha(touch.has-hover ? 0.9 : 0.35);
    HorizontalLayout {
        padding-left: Tokens.space-margin;
        padding-right: Tokens.space-margin;
        spacing: Tokens.space-unit;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Label { role: "body"; text: root.label; wrap: no-wrap; overflow: elide; opacity: root.live ? 1 : 0.45; }
            if root.reason != "": Label { role: "caption"; muted: true; text: root.reason; wrap: no-wrap; overflow: elide; }
        }
        Rectangle {
            width: 40px;
            height: 24px;
            // Disabled: the whole control dims, not only its label (ui-model §5).
            opacity: root.live ? 1 : 0.45;
            y: (parent.height - self.height) / 2;
            border-radius: self.height / 2;
            border-width: Blueprint.on ? 1px : 0;
            border-color: Blueprint.ink.with-alpha(root.on ? Blueprint.text : Blueprint.outline);
            background: Blueprint.on ? Blueprint.ink.with-alpha(root.on ? 0.14 : 0) : (root.on ? Tokens.text-primary : Tokens.surface-active);
            // (the track is the setting's state: structure, in ink)
            animate background { duration: Motion.reduce ? 0 : Tokens.motion-duration-fast; }
            Rectangle {
                width: 18px;
                height: 18px;
                y: 3px;
                // On is at the end: mirrored right to left.
                x: (root.on != Layout.rtl) ? parent.width - self.width - 3px : 3px;
                border-radius: self.height / 2;
                border-width: Blueprint.on ? 1px : 0;
                border-color: Blueprint.ink.with-alpha(Blueprint.text);
                background: Blueprint.on ? transparent : (root.on ? Tokens.bg : Tokens.text-secondary);
                animate x { duration: Motion.reduce ? 0 : Tokens.motion-duration-fast; easing: cubic-bezier(0.2, 0, 0, 1); }
            }
        }
    }
    // Focusable (focus on entry, design system §8.4): Enter or Space takes it; the ring shows it.
    forward-focus: fs;
    fs := FocusScope {
        // Disabled is skipped by the buttons and a touch (input events §3.7): it keeps its place
        // and its reason shows, but takes no focus.
        focus-on-tab-navigation: root.live;
        focus-on-click: root.live;
        changed has-focus => {
            if self.has-focus {
                FocusReveal.y = root.absolute-position.y;
                FocusReveal.h = root.height;
                FocusReveal.serial += 1;
            }
        }
        key-pressed(e) => {
            // Hidden focus: a navigation key only reveals it; Action and Escape go to the screen.
            if !FocusVisible.on { if e.text == Key.Return || e.text == " " || e.text == Key.Escape { return reject; } FocusVisible.on = true; return accept; }
            if e.text == Key.Return || e.text == " " { if root.live { root.on = !root.on; root.toggled(root.on); } return accept; }
            reject
        }
    }
    if fs.has-focus && FocusVisible.on: Rectangle { border-radius: 0; border-width: 2px; border-color: Tokens.focus; }
    touch := TapArea {
        unit: root.unit; down => { fs.focus(); } tapped => { if root.live { root.on = !root.on; root.toggled(root.on); } } }
    Measure { width: parent.width; height: parent.height; shown: touch.has-hover || touch.pressed; unit: root.unit; }
}

// A slider: a value on a track, dragged or stepped; in blueprint, the track as a dimension line
// and the value beside the knob.
export component Slider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in-out property <float> value: 50;
    in property <string> label;
    in property <float> unit: 1.0;
    // Disabled: dimmed, no focus, no touch (ADR 0003).
    in property <bool> enabled: true;
    opacity: root.enabled ? 1 : 0.45;
    accessible-enabled: root.enabled;
    callback changed(float);
    height: Tokens.size-target-min;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: round(root.value);
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-description: root.adjusting ? "Adjusting: the volume buttons move the value" : "";
    // A screen reader adjusts it as the buttons do.
    accessible-action-increment => { root.nudge(root.step); }
    accessible-action-decrement => { root.nudge(-root.step); }
    property <float> t: (root.value - root.minimum) / max(1, root.maximum - root.minimum);
    // Where it is drawn: from the start edge, mirrored right to left.
    property <float> tv: Layout.rtl ? 1 - root.t : root.t;
    property <length> knob: 20px;
    // The lock ends when the focus hides (a touch elsewhere): Escape then means back again.
    property <bool> shown: FocusVisible.on;
    changed shown => { if !self.shown { root.adjusting = false; } }
    // Locked for adjustment (Enter, Action or Space on the focused knob): the volume buttons and
    // the arrows move the value instead of the focus, until it is released the same way or the
    // focus leaves.
    in-out property <bool> adjusting;
    property <float> step: (root.maximum - root.minimum) / 20;
    function nudge(by: float) {
        root.value = max(root.minimum, min(root.maximum, root.value + by));
        root.changed(root.value);
    }
    // The track.
    Rectangle {
        x: root.knob / 2;
        width: parent.width - root.knob;
        y: (parent.height - self.height) / 2;
        height: Blueprint.on ? 1px : 4px;
        border-radius: 2px;
        background: Blueprint.on ? Blueprint.ink.with-alpha(Blueprint.outline) : Tokens.surface-active;
        // The fill, from the start of the track to the knob's centre.
        Rectangle {
            x: Layout.rtl ? parent.width * (1 - root.t) : 0;
            width: parent.width * root.t;
            border-radius: 2px;
            background: Blueprint.on ? Blueprint.ink.with-alpha(Blueprint.text) : Tokens.text-primary;
        }
    }
    if Blueprint.on: Rectangle { x: root.knob / 2; width: 1px; y: (parent.height - 9px) / 2; height: 9px; background: Blueprint.ink.with-alpha(Blueprint.secondary); }
    if Blueprint.on: Rectangle { x: parent.width - root.knob / 2 - 1px; width: 1px; y: (parent.height - 9px) / 2; height: 9px; background: Blueprint.ink.with-alpha(Blueprint.secondary); }
    // The focus is on the knob, the control, not on the field: its ring around it; locked for
    // adjustment, the ring turns to live input.
    if fs.has-focus && FocusVisible.on: Rectangle {
        x: (parent.width - root.knob) * root.tv - 4px;
        y: (parent.height - root.knob) / 2 - 4px;
        width: root.knob + 8px;
        height: root.knob + 8px;
        border-radius: self.width / 2;
        // Locked for adjustment it reads apart from plain focus: a thicker ring and a filled halo.
        border-width: root.adjusting ? 3px : 2px;
        border-color: root.adjusting ? (Blueprint.on ? Blueprint.live : Tokens.brand-base) : Tokens.focus;
        background: root.adjusting ? (Blueprint.on ? Blueprint.live : Tokens.brand-base).with-alpha(0.45) : transparent;
    }
    // The knob.
    Rectangle {
        x: (parent.width - root.knob) * root.tv;
        y: (parent.height - root.knob) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        border-width: Blueprint.on ? 1px : 0;
        border-color: touch.pressed ? Blueprint.live : Blueprint.interactive;
        background: Blueprint.on ? (touch.pressed ? Blueprint.live.with-alpha(0.3) : Blueprint.paper) : Tokens.text-primary;
    }
    if Blueprint.on: Text {
        x: min(parent.width - self.width, max(0, (parent.width - root.knob) * root.tv + root.knob / 2 - self.width / 2));
        y: 0;
        text: round(root.value);
        font-family: Tokens.font-family-mono;
        font-size: 10px;
        color: Blueprint.ink.with-alpha(Blueprint.text);
    }
    // Focusable (focus on entry, design system §8.4): Enter or Space takes it; the ring shows it.
    forward-focus: fs;
    fs := FocusScope {
        // Disabled is skipped by the buttons and a touch (input events §3.7): it keeps its place
        // and its reason shows, but takes no focus.
        focus-on-tab-navigation: root.enabled;
        focus-on-click: root.enabled;
        changed has-focus => {
            if !self.has-focus { root.adjusting = false; }
            if self.has-focus {
                FocusReveal.y = root.absolute-position.y;
                FocusReveal.h = root.height;
                FocusReveal.serial += 1;
            }
        }
        key-pressed(e) => {
            // Hidden focus: a navigation key only reveals it; Action and Escape go to the screen.
            if !FocusVisible.on { if e.text == Key.Return || e.text == " " || e.text == Key.Escape { return reject; } FocusVisible.on = true; return accept; }
            if e.text == Key.Return || e.text == " " { root.adjusting = !root.adjusting; return accept; }
            if e.text == Key.Escape && root.adjusting { root.adjusting = false; return accept; }
            // ← → step the value by 5 % always (a keyboard's arrows, W3C's slider), mirrored right to
            // left. The volume buttons (Tab, Shift+Tab from the shell) and ↑ ↓ (the same buttons by
            // their place, design system §8.4) only while locked: Volume + up, Volume − down,
            // never mirrored.
            let less = Layout.rtl ? Key.RightArrow : Key.LeftArrow;
            let more = Layout.rtl ? Key.LeftArrow : Key.RightArrow;
            if e.text == less || (root.adjusting && e.text == Key.DownArrow) { root.nudge(-root.step); return accept; }
            if e.text == more || (root.adjusting && e.text == Key.UpArrow) { root.nudge(root.step); return accept; }
            if root.adjusting && e.text == Key.Tab && !e.modifiers.shift { root.nudge(-root.step); return accept; }
            if root.adjusting && (e.text == Key.Backtab || (e.text == Key.Tab && e.modifiers.shift)) { root.nudge(root.step); return accept; }
            reject
        }
    }
    // The value follows the finger once it moves along the track past the slop (a drag with the
    // horizontal axis: a vertical move scrolls the page and takes nothing); a tap sets the value
    // where it lands; a cancel puts back the value it had at the press (input events §3.2).
    // Right to left, the track runs from the right.
    function set-from(x: length) {
        let f = max(0, min(1, (x - root.knob / 2) / (root.width - root.knob)));
        root.value = root.minimum + (Layout.rtl ? 1 - f : f) * (root.maximum - root.minimum);
        root.changed(root.value);
    }
    property <bool> dragging;
    property <float> at-press;
    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down { FocusVisible.on = false; fs.focus(); root.dragging = false; root.at-press = root.value; }
            if e.kind == PointerEventKind.up && !root.dragging
                && abs(self.mouse-y - self.pressed-y) < 10px * root.unit { root.set-from(self.mouse-x); }
            if e.kind == PointerEventKind.cancel { root.value = root.at-press; root.changed(root.value); root.dragging = false; }
        }
        moved => {
            if self.pressed && !root.dragging
                && abs(self.mouse-x - self.pressed-x) >= 10px * root.unit
                && abs(self.mouse-x - self.pressed-x) > abs(self.mouse-y - self.pressed-y) { root.dragging = true; }
            if self.pressed && root.dragging { root.set-from(self.mouse-x); }
        }
    }
    Measure { width: parent.width; height: parent.height; shown: touch.has-hover || touch.pressed; unit: root.unit; }
}

// A range: two knobs on one track, low and high; a press takes the nearer knob, and they never
// cross. In blueprint, the track is a dimension line and each value shows over its knob.
export component RangeSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in-out property <float> low: 20;
    in-out property <float> high: 80;
    in property <string> label;
    in property <float> unit: 1.0;
    // Disabled: dimmed, no focus, no touch (ADR 0003).
    in property <bool> enabled: true;
    opacity: root.enabled ? 1 : 0.45;
    accessible-enabled: root.enabled;
    callback changed(float, float);
    height: Tokens.size-target-min;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: round(root.low) + " to " + round(root.high);
    property <length> knob: 20px;
    property <float> span: max(1, root.maximum - root.minimum);
    // Where the knobs are drawn: from the start edge, mirrored right to left (the low knob on the
    // right).
    property <length> lx: root.mirror((root.width - root.knob) * (root.low - root.minimum) / root.span);
    property <length> hx: root.mirror((root.width - root.knob) * (root.high - root.minimum) / root.span);
    pure function mirror(x: length) -> length { return Layout.rtl ? (root.width - root.knob) - x : x; }
    accessible-action-increment => { root.move-active((root.active == 0 ? root.low : root.high) + root.span / 20); }
    accessible-action-decrement => { root.move-active((root.active == 0 ? root.low : root.high) - root.span / 20); }
    // The lock ends when the focus hides.
    property <bool> shown: FocusVisible.on;
    changed shown => { if !self.shown { root.adjusting = false; } }
    // Which knob a drag moves, and the one the focus is on: 0 low, 1 high.
    property <int> active;
    // Locked for adjustment, as the slider is (Enter, Action or Space).
    in-out property <bool> adjusting;
    Rectangle {
        x: root.knob / 2;
        width: parent.width - root.knob;
        y: (parent.height - self.height) / 2;
        height: Blueprint.on ? 1px : 4px;
        border-radius: 2px;
        background: Blueprint.on ? Blueprint.ink.with-alpha(Blueprint.outline) : Tokens.surface-active;
        Rectangle {
            x: min(root.lx, root.hx);
            width: abs(root.hx - root.lx);
            border-radius: 2px;
            background: Blueprint.on ? Blueprint.ink.with-alpha(Blueprint.text) : Tokens.text-primary;
        }
    }
    for k[i] in [root.lx, root.hx]: Rectangle {
        x: k;
        y: (parent.height - root.knob) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        border-width: Blueprint.on ? 1px : 0;
        border-color: touch.pressed && root.active == i ? Blueprint.live : Blueprint.interactive;
        background: Blueprint.on ? (touch.pressed && root.active == i ? Blueprint.live.with-alpha(0.3) : Blueprint.paper) : Tokens.text-primary;
    }
    // The focus is on one knob at a time, the control: its ring; locked, in live colour.
    if fs.has-focus && FocusVisible.on: Rectangle {
        x: (root.active == 0 ? root.lx : root.hx) - 4px;
        y: (parent.height - root.knob) / 2 - 4px;
        width: root.knob + 8px;
        height: root.knob + 8px;
        border-radius: self.width / 2;
        // Locked for adjustment it reads apart from plain focus: a thicker ring and a filled halo.
        border-width: root.adjusting ? 3px : 2px;
        border-color: root.adjusting ? (Blueprint.on ? Blueprint.live : Tokens.brand-base) : Tokens.focus;
        background: root.adjusting ? (Blueprint.on ? Blueprint.live : Tokens.brand-base).with-alpha(0.45) : transparent;
    }
    if Blueprint.on: Text {
        x: max(0, root.lx + root.knob / 2 - self.width / 2);
        y: 0;
        text: round(root.low);
        font-family: Tokens.font-family-mono;
        font-size: 10px;
        color: Blueprint.ink.with-alpha(Blueprint.text);
    }
    if Blueprint.on: Text {
        x: min(parent.width - self.width, root.hx + root.knob / 2 - self.width / 2);
        y: 0;
        text: round(root.high);
        font-family: Tokens.font-family-mono;
        font-size: 10px;
        color: Blueprint.ink.with-alpha(Blueprint.text);
    }
    function value-at(x: length) -> float {
        let f = max(0, min(1, (x - root.knob / 2) / (root.width - root.knob)));
        return root.minimum + (Layout.rtl ? 1 - f : f) * root.span;
    }
    function move-active(v: float) {
        if root.active == 0 { root.low = min(v, root.high); } else { root.high = max(v, root.low); }
        root.changed(root.low, root.high);
    }
    forward-focus: fs;
    fs := FocusScope {
        // Disabled is skipped by the buttons and a touch (input events §3.7): it keeps its place
        // and its reason shows, but takes no focus.
        focus-on-tab-navigation: root.enabled;
        focus-on-click: root.enabled;
        changed has-focus => {
            if !self.has-focus { root.adjusting = false; }
            if self.has-focus {
                // Reached backward (Volume +, Shift+Tab): from the high knob; forward, from the low
                // one. A touch chose its knob itself: left as it is.
                if FocusVisible.on { root.active = FocusNav.backward ? 1 : 0; }
                FocusReveal.y = root.absolute-position.y;
                FocusReveal.h = root.height;
                FocusReveal.serial += 1;
            }
        }
        key-pressed(e) => {
            // Hidden focus: a navigation key only reveals it; Action and Escape go to the screen.
            if !FocusVisible.on { if e.text == Key.Return || e.text == " " || e.text == Key.Escape { return reject; } FocusVisible.on = true; return accept; }
            if e.text == Key.Return || e.text == " " { root.adjusting = !root.adjusting; return accept; }
            if e.text == Key.Escape && root.adjusting { root.adjusting = false; return accept; }
            let less = Layout.rtl ? Key.RightArrow : Key.LeftArrow;
            let more = Layout.rtl ? Key.LeftArrow : Key.RightArrow;
            if e.text == less || (root.adjusting && e.text == Key.DownArrow) { root.move-active((root.active == 0 ? root.low : root.high) - root.span / 20); return accept; }
            if e.text == more || (root.adjusting && e.text == Key.UpArrow) { root.move-active((root.active == 0 ? root.low : root.high) + root.span / 20); return accept; }
            // Locked: the volume buttons move the focused knob (Volume + up, Volume − down).
            if root.adjusting && e.text == Key.Tab && !e.modifiers.shift { root.move-active((root.active == 0 ? root.low : root.high) - root.span / 20); return accept; }
            if root.adjusting && (e.text == Key.Backtab || (e.text == Key.Tab && e.modifiers.shift)) { root.move-active((root.active == 0 ? root.low : root.high) + root.span / 20); return accept; }
            // Free: the focus walks low → high, then leaves.
            if e.text == Key.Tab && !e.modifiers.shift && root.active == 0 { root.active = 1; return accept; }
            if (e.text == Key.Backtab || (e.text == Key.Tab && e.modifiers.shift)) && root.active == 1 { root.active = 0; return accept; }
            reject
        }
    }
    // As the slider: a knob is chosen at the press (the nearer; with both together, the one on
    // the side the touch falls), it moves once the finger travels along the track past the slop
    // or on a tap, and a cancel puts both back.
    property <bool> dragging;
    property <float> low-at-press;
    property <float> high-at-press;
    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                FocusVisible.on = false;
                fs.focus();
                root.dragging = false;
                root.low-at-press = root.low;
                root.high-at-press = root.high;
                let dl = abs(self.mouse-x - (root.lx + root.knob / 2));
                let dh = abs(self.mouse-x - (root.hx + root.knob / 2));
                root.active = abs(dl - dh) < 1px
                    ? ((self.mouse-x > root.lx + root.knob / 2) != Layout.rtl ? 1 : 0)
                    : (dl < dh ? 0 : 1);
            }
            if e.kind == PointerEventKind.up && !root.dragging
                && abs(self.mouse-y - self.pressed-y) < 10px * root.unit { root.move-active(root.value-at(self.mouse-x)); }
            if e.kind == PointerEventKind.cancel {
                root.low = root.low-at-press;
                root.high = root.high-at-press;
                root.changed(root.low, root.high);
                root.dragging = false;
            }
        }
        moved => {
            if self.pressed && !root.dragging
                && abs(self.mouse-x - self.pressed-x) >= 10px * root.unit
                && abs(self.mouse-x - self.pressed-x) > abs(self.mouse-y - self.pressed-y) { root.dragging = true; }
            if self.pressed && root.dragging { root.move-active(root.value-at(self.mouse-x)); }
        }
    }
    Measure { width: parent.width; height: parent.height; shown: touch.has-hover || touch.pressed; unit: root.unit; }
}

// One segment of a button group (§15.1): the capsule's outer ends on the first and last segment,
// flat inner edges, a 1 px split.
export component Segment inherits Rectangle {
    in property <bool> enabled: true;
    // Why it is disabled (ADR 0003): shown to the screen reader, and it disables the control.
    in property <string> reason;
    property <bool> live: root.enabled && root.reason == "";
    in property <string> label;
    in property <bool> selected;
    in property <bool> first;
    in property <bool> last;
    in property <float> unit: 1.0;
    callback clicked();
    height: Tokens.size-target-min;
    border-top-left-radius: root.first ? self.height / 2 : 0;
    border-bottom-left-radius: root.first ? self.height / 2 : 0;
    border-top-right-radius: root.last ? self.height / 2 : 0;
    border-bottom-right-radius: root.last ? self.height / 2 : 0;
    border-width: Blueprint.on ? 1px : 0;
    border-color: touch.pressed ? Blueprint.live : Blueprint.interactive.with-alpha(touch.has-hover || root.selected ? 0.9 : 0.6);
    background: Blueprint.on
        ? (touch.pressed ? Blueprint.live.with-alpha(0.2) : Blueprint.ink.with-alpha(root.selected ? 0.14 : (touch.has-hover ? Blueprint.fill : 0)))
        : (touch.pressed ? Tokens.surface-active : (root.selected ? Tokens.surface-active : Tokens.surface-raised));
    opacity: root.live ? 1 : 0.45;
    accessible-enabled: root.live;
    accessible-description: root.reason;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.selected;
    accessible-action-default => { if root.live { root.clicked(); } }
    Text {
        text: root.label;
        font-family: Tokens.font-family-ui;
        font-size: Tokens.font-size-label;
        // The selected segment's non-colour cue: its weight (§15.1).
        font-weight: root.selected ? Tokens.font-weight-semibold : Tokens.font-weight-regular;
        color: root.selected ? Ink.text : Ink.secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // Focusable (focus on entry, design system §8.4): Enter or Space takes it; the ring shows it.
    forward-focus: fs;
    fs := FocusScope {
        // Disabled is skipped by the buttons and a touch (input events §3.7): it keeps its place
        // and its reason shows, but takes no focus.
        focus-on-tab-navigation: root.live;
        focus-on-click: root.live;
        changed has-focus => {
            if self.has-focus {
                FocusReveal.y = root.absolute-position.y;
                FocusReveal.h = root.height;
                FocusReveal.serial += 1;
            }
        }
        key-pressed(e) => {
            // Hidden focus: a navigation key only reveals it; Action and Escape go to the screen.
            if !FocusVisible.on { if e.text == Key.Return || e.text == " " || e.text == Key.Escape { return reject; } FocusVisible.on = true; return accept; }
            if e.text == Key.Return || e.text == " " { if root.live { root.clicked(); } return accept; }
            reject
        }
    }
    if fs.has-focus && FocusVisible.on: Rectangle { border-radius: min(root.height / 2, 8px); border-width: 2px; border-color: Tokens.focus; }
    touch := TapArea {
        unit: root.unit; down => { fs.focus(); } enabled: root.live; tapped => { root.clicked(); } }
    Measure { width: parent.width; height: parent.height; shown: touch.has-hover || touch.pressed; unit: root.unit; }
}

// —— Navigation ——————————————————————————————————————————————————————————————————————————

// An icon-only action (§15.3): a 24 px glyph in a 48 px hit area, with its accessible name.
export component IconButton inherits Rectangle {
    in property <bool> enabled: true;
    // Why it is disabled (ADR 0003): shown to the screen reader, and it disables the control.
    in property <string> reason;
    property <bool> live: root.enabled && root.reason == "";
    in property <image> icon;
    in property <string> name;
    in property <float> unit: 1.0;
    callback clicked();
    width: Tokens.size-target-min;
    height: Tokens.size-target-min;
    border-radius: Tokens.radius-control;
    border-width: Blueprint.on ? 1px : 0;
    border-color: touch.pressed ? Blueprint.live : Blueprint.interactive.with-alpha(touch.has-hover ? 0.9 : 0.35);
    background: Blueprint.on
        ? (touch.pressed ? Blueprint.live.with-alpha(0.2) : Blueprint.interactive.with-alpha(touch.has-hover ? 0.1 : 0))
        : (touch.pressed ? Tokens.surface-active : (touch.has-hover ? Tokens.surface-raised : transparent));
    opacity: root.live ? 1 : 0.45;
    accessible-enabled: root.live;
    accessible-description: root.reason;
    accessible-role: button;
    accessible-label: root.name;
    accessible-action-default => { if root.live { root.clicked(); } }
    Image {
        source: root.icon;
        width: 24px;
        height: 24px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: Ink.text;
    }
    forward-focus: fs;
    fs := FocusScope {
        // Disabled is skipped by the buttons and a touch (input events §3.7): it keeps its place
        // and its reason shows, but takes no focus.
        focus-on-tab-navigation: root.live;
        focus-on-click: root.live;
        changed has-focus => {
            if self.has-focus {
                FocusReveal.y = root.absolute-position.y;
                FocusReveal.h = root.height;
                FocusReveal.serial += 1;
            }
        }
        key-pressed(e) => {
            // Hidden focus: a navigation key only reveals it; Action and Escape go to the screen.
            if !FocusVisible.on { if e.text == Key.Return || e.text == " " || e.text == Key.Escape { return reject; } FocusVisible.on = true; return accept; }
            if e.text == Key.Return || e.text == " " { if root.live { root.clicked(); } return accept; }
            reject
        }
    }
    if fs.has-focus && FocusVisible.on: Rectangle { border-radius: root.border-radius; border-width: 2px; border-color: Tokens.focus; }
    touch := TapArea {
        unit: root.unit; down => { fs.focus(); } enabled: root.live; tapped => { root.clicked(); } }
    Measure { width: parent.width; height: parent.height; shown: touch.has-hover || touch.pressed; unit: root.unit; }
}

// One tab (§15): views of the same level. Text, the current one in `text` with a 2 px underline,
// the others `text-muted`; no container; at least 48 × 48.
export component Tab inherits Rectangle {
    in property <bool> enabled: true;
    // Why it is disabled (ADR 0003): shown to the screen reader, and it disables the control.
    in property <string> reason;
    property <bool> live: root.enabled && root.reason == "";
    in property <string> label;
    in property <bool> current;
    in property <float> unit: 1.0;
    callback clicked();
    height: Tokens.size-target-min;
    min-width: Tokens.size-target-min;
    background: Blueprint.on
        ? (touch.pressed ? Blueprint.live.with-alpha(0.2) : Blueprint.interactive.with-alpha(touch.has-hover ? 0.1 : 0))
        : transparent;
    opacity: root.live ? 1 : 0.45;
    accessible-enabled: root.live;
    accessible-description: root.reason;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-checked: root.current;
    accessible-action-default => { if root.live { root.clicked(); } }
    HorizontalLayout {
        padding-left: Tokens.space-unit;
        padding-right: Tokens.space-unit;
        Text {
            text: root.label;
            font-family: Tokens.font-family-ui;
            font-size: Tokens.font-size-body;
            font-weight: root.current ? Tokens.font-weight-semibold : Tokens.font-weight-regular;
            color: root.current ? Ink.text : Ink.muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if root.current: Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: Blueprint.on ? Blueprint.ink.with-alpha(Blueprint.text) : Tokens.text-primary;
    }
    if Blueprint.on && !root.current: Rectangle { y: parent.height - 1px; height: 1px; background: Blueprint.interactive.with-alpha(0.35); }
    forward-focus: fs;
    fs := FocusScope {
        // Disabled is skipped by the buttons and a touch (input events §3.7): it keeps its place
        // and its reason shows, but takes no focus.
        focus-on-tab-navigation: root.live;
        focus-on-click: root.live;
        changed has-focus => {
            if self.has-focus {
                FocusReveal.y = root.absolute-position.y;
                FocusReveal.h = root.height;
                FocusReveal.serial += 1;
            }
        }
        key-pressed(e) => {
            // Hidden focus: a navigation key only reveals it; Action and Escape go to the screen.
            if !FocusVisible.on { if e.text == Key.Return || e.text == " " || e.text == Key.Escape { return reject; } FocusVisible.on = true; return accept; }
            if e.text == Key.Return || e.text == " " { if root.live { root.clicked(); } return accept; }
            reject
        }
    }
    if fs.has-focus && FocusVisible.on: Rectangle { border-width: 2px; border-color: Tokens.focus; }
    touch := TapArea {
        unit: root.unit; down => { fs.focus(); } enabled: root.live; tapped => { root.clicked(); } }
    Measure { width: parent.width; height: parent.height; shown: touch.has-hover || touch.pressed; unit: root.unit; }
}

// A group's label (§9.2, §10.1): a group step after the previous group, a unit step before its
// first line.
export component SectionLabel inherits Text {
    font-family: Tokens.font-family-ui;
    font-size: Tokens.font-size-caption;
    font-weight: Tokens.font-weight-medium;
    color: Ink.secondary;
    accessible-role: AccessibleRole.text;
}

// —— Selection ———————————————————————————————————————————————————————————————————————————

// Radio stops on an axis (§15.2): one of a few options on a meaningful scale; the selected stop
// enlarged and described in words.
export component RadioStops inherits VerticalLayout {
    in property <[string]> stops;
    in-out property <int> selected;
    in property <string> description;
    in property <float> unit: 1.0;
    // Disabled: dimmed, no focus, no touch (ADR 0003).
    in property <bool> enabled: true;
    opacity: root.enabled ? 1 : 0.45;
    callback changed(int);
    // Locked for adjustment (Enter, Action or Space), as a slider: the volume buttons move the
    // choice instead of the focus, until it is released the same way, by Escape, or the focus
    // leaves. ← → move it at any time.
    in-out property <bool> adjusting;
    // The lock ends when the focus hides.
    property <bool> shown: FocusVisible.on;
    changed shown => { if !self.shown { root.adjusting = false; } }
    // A stop's place along the axis, from the start edge, mirrored right to left.
    pure function place(i: int, w: length) -> length {
        let p = i * (w - Tokens.size-target-min) / max(1, root.stops.length - 1);
        return Layout.rtl ? (w - Tokens.size-target-min) - p : p;
    }
    function pick(i: int) {
        if i >= 0 && i < root.stops.length && i != root.selected { root.selected = i; root.changed(i); }
    }
    forward-focus: fs;
    spacing: Tokens.space-unit;
    Rectangle {
        height: Tokens.size-target-min;
        Rectangle {
            x: Tokens.size-target-min / 2;
            width: parent.width - Tokens.size-target-min;
            // Centred on the stops: its own thickness taken out.
            y: (parent.height - self.height) / 2;
            height: Blueprint.on ? 1px : 2px;
            background: Blueprint.on ? Blueprint.ink.with-alpha(Blueprint.outline) : Tokens.surface-active;
        }
        for stop[i] in root.stops: Rectangle {
            x: root.place(i, parent.width);
            width: Tokens.size-target-min;
            height: Tokens.size-target-min;
            accessible-role: radio-button;
            accessible-label: stop;
            accessible-checked: i == root.selected;
            accessible-action-default => { root.selected = i; root.changed(i); }
            property <length> d: i == root.selected ? 22px : 12px;
            Rectangle {
                width: parent.d;
                height: parent.d;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                border-width: Blueprint.on ? 1px : 0;
                border-color: stop-touch.pressed ? Blueprint.live : Blueprint.interactive.with-alpha(0.8);
                background: Blueprint.on
                    ? (i == root.selected ? Blueprint.ink.with-alpha(0.3) : Blueprint.paper)
                    : (i == root.selected ? Tokens.text-primary : Tokens.color-graphite-700);
                animate width, height { duration: Motion.reduce ? 0 : Tokens.motion-duration-fast; }
            }
            stop-touch := TapArea {
                enabled: root.enabled;
        unit: root.unit; down => { fs.focus(); } tapped => { root.selected = i; root.changed(i); } }
        }
        fs := FocusScope {
        // Disabled is skipped by the buttons and a touch (input events §3.7): it keeps its place
        // and its reason shows, but takes no focus.
        focus-on-tab-navigation: root.enabled;
        focus-on-click: root.enabled;
        changed has-focus => {
            if !self.has-focus { root.adjusting = false; }
            if self.has-focus {
                FocusReveal.y = root.absolute-position.y;
                FocusReveal.h = root.height;
                FocusReveal.serial += 1;
            }
        }
            key-pressed(e) => {
            // Hidden focus: a navigation key only reveals it; Action and Escape go to the screen.
            if !FocusVisible.on { if e.text == Key.Return || e.text == " " || e.text == Key.Escape { return reject; } FocusVisible.on = true; return accept; }
                if e.text == Key.Return || e.text == " " { root.adjusting = !root.adjusting; return accept; }
                if e.text == Key.Escape && root.adjusting { root.adjusting = false; return accept; }
                let less = Layout.rtl ? Key.RightArrow : Key.LeftArrow;
                let more = Layout.rtl ? Key.LeftArrow : Key.RightArrow;
                if e.text == less || (root.adjusting && e.text == Key.DownArrow) { root.pick(root.selected - 1); return accept; }
                if e.text == more || (root.adjusting && e.text == Key.UpArrow) { root.pick(root.selected + 1); return accept; }
                // Locked: Volume + (Shift+Tab) to the next stop, Volume − (Tab) to the previous,
                // as a slider's value goes up and down.
                if root.adjusting && e.text == Key.Tab && !e.modifiers.shift { root.pick(root.selected - 1); return accept; }
                if root.adjusting && (e.text == Key.Backtab || (e.text == Key.Tab && e.modifiers.shift)) { root.pick(root.selected + 1); return accept; }
                reject
            }
        }
        // The focus is on the chosen stop, the control, not on the whole axis (as a slider's knob).
        if fs.has-focus && FocusVisible.on: Rectangle {
            x: root.place(root.selected, parent.width) + (Tokens.size-target-min - 30px) / 2;
            y: (parent.height - 30px) / 2;
            width: 30px;
            height: 30px;
            border-radius: 15px;
            border-width: root.adjusting ? 3px : 2px;
            border-color: root.adjusting ? (Blueprint.on ? Blueprint.live : Tokens.brand-base) : Tokens.focus;
        }
    }
    HorizontalLayout {
        Label { role: "label"; text: root.stops[root.selected]; horizontal-stretch: 0; wrap: no-wrap; }
        Label { role: "label"; muted: true; text: root.description == "" ? "" : "  ·  " + root.description; overflow: elide; wrap: no-wrap; }
    }
}

// A line that picks one item of a list (first-run language): a check on the chosen one.
export component CheckLine inherits Rectangle {
    in property <bool> enabled: true;
    // Why it is disabled (ADR 0003): shown to the screen reader, and it disables the control.
    in property <string> reason;
    property <bool> live: root.enabled && root.reason == "";
    in property <string> label;
    in property <bool> checked;
    in property <float> unit: 1.0;
    callback clicked();
    height: Tokens.size-row;
    background: Blueprint.on
        ? (touch.pressed ? Blueprint.live.with-alpha(0.2) : Blueprint.interactive.with-alpha(touch.has-hover ? 0.1 : 0))
        : (touch.pressed ? Tokens.surface-active : (touch.has-hover ? Tokens.surface-base : transparent));
    border-width: Blueprint.on ? 1px : 0;
    border-color: touch.pressed ? Blueprint.live : Blueprint.interactive.with-alpha(touch.has-hover ? 0.9 : 0.35);
    opacity: root.live ? 1 : 0.45;
    accessible-enabled: root.live;
    accessible-description: root.reason;
    accessible-role: radio-button;
    accessible-label: root.label;
    accessible-checked: root.checked;
    accessible-action-default => { if root.live { root.clicked(); } }
    HorizontalLayout {
        padding-left: Tokens.space-margin;
        padding-right: Tokens.space-margin;
        Label { role: "body"; text: root.label; vertical-alignment: center; horizontal-stretch: 1; wrap: no-wrap; overflow: elide; font-weight: root.checked ? Tokens.font-weight-semibold : Tokens.font-weight-regular; }
        if root.checked: Image { source: @image-url("../icons/24/done.svg"); width: 20px; height: 20px; y: (parent.height - self.height) / 2; colorize: Ink.text; }
    }
    Rectangle { y: parent.height - Tokens.size-group-divider; height: Tokens.size-group-divider; background: Ink.line; }
    forward-focus: fs;
    fs := FocusScope {
        // Disabled is skipped by the buttons and a touch (input events §3.7): it keeps its place
        // and its reason shows, but takes no focus.
        focus-on-tab-navigation: root.live;
        focus-on-click: root.live;
        changed has-focus => {
            if self.has-focus {
                FocusReveal.y = root.absolute-position.y;
                FocusReveal.h = root.height;
                FocusReveal.serial += 1;
            }
        }
        key-pressed(e) => {
            // Hidden focus: a navigation key only reveals it; Action and Escape go to the screen.
            if !FocusVisible.on { if e.text == Key.Return || e.text == " " || e.text == Key.Escape { return reject; } FocusVisible.on = true; return accept; }
            if e.text == Key.Return || e.text == " " { if root.live { root.clicked(); } return accept; }
            reject
        }
    }
    if fs.has-focus && FocusVisible.on: Rectangle { border-width: 2px; border-color: Tokens.focus; }
    touch := TapArea {
        unit: root.unit; down => { fs.focus(); } enabled: root.live; tapped => { root.clicked(); } }
    Measure { width: parent.width; height: parent.height; shown: touch.has-hover || touch.pressed; unit: root.unit; }
}

// —— Values, progress and status ——————————————————————————————————————————————————————————

// A technical value (§15): its label, and the value in mono, right-aligned, Western digits.
export component Readout inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    height: 28px;
    Label { role: "label"; muted: true; text: root.label; vertical-alignment: center; horizontal-stretch: 1; wrap: no-wrap; overflow: elide; }
    Label { role: "label"; mono: true; text: root.value; vertical-alignment: center; horizontal-alignment: right; wrap: no-wrap; }
}

// A determinate bar (storage, indexing, a dose): its value over its maximum.
export component ProgressBar inherits Rectangle {
    in property <float> value;
    in property <float> maximum: 1.0;
    in property <color> tint: Blueprint.on ? Blueprint.ink.with-alpha(Blueprint.text) : Tokens.text-primary;
    height: 4px;
    border-radius: 2px;
    background: Blueprint.on ? Blueprint.ink.with-alpha(Blueprint.faint) : Tokens.surface-active;
    accessible-role: progress-indicator;
    accessible-value: round(100 * root.value / max(0.0001, root.maximum)) + " %";
    Rectangle {
        x: 0;
        width: parent.width * max(0, min(1, root.value / max(0.0001, root.maximum)));
        border-radius: 2px;
        background: root.tint;
        animate width { duration: Motion.reduce ? 0 : Tokens.motion-duration-standard; }
    }
}

// Loading of unknown length (ADR 0003): a 2 px line under the header, in `state-info`, shown past
// 300 ms; it holds still under reduce-motion (`moving: false`).
export component LoadingLine inherits Rectangle {
    in property <bool> moving: true;
    height: 2px;
    clip: true;
    accessible-role: progress-indicator;
    accessible-label: "Loading";
    property <float> t: root.moving ? mod(animation-tick(), 1400ms) / 1400ms : 0.35;
    Rectangle {
        x: (parent.width * 1.4) * root.t - parent.width * 0.4;
        width: parent.width * 0.4;
        background: Tokens.state-info;
    }
}

// A seek bar (§9.5): the position and the times, elapsed and remaining; never mirrored.
export component SeekBar inherits VerticalLayout {
    in-out property <float> position;
    in property <float> length: 1;
    in property <string> elapsed;
    in property <string> remaining;
    in property <float> unit: 1.0;
    callback seek(float);
    spacing: Tokens.space-unit;
    // Focus on entry lands on its slider.
    forward-focus: seek-slider;
    seek-slider := Slider {
        minimum: 0;
        maximum: root.length;
        value <=> root.position;
        label: "Position";
        unit: root.unit;
        changed(v) => { root.seek(v); }
    }
    HorizontalLayout {
        Label { role: "caption"; mono: true; muted: true; text: root.elapsed; horizontal-stretch: 1; wrap: no-wrap; }
        Label { role: "caption"; mono: true; muted: true; text: root.remaining; horizontal-alignment: right; wrap: no-wrap; }
    }
}

// A state in semantic colour, never by colour alone (DS-010, §15): its icon and its word.
// `kind`: "success", "warning", "error", "info", "processing".
export component StatusIndicator inherits HorizontalLayout {
    in property <string> kind: "info";
    in property <string> label;
    property <color> tint: root.kind == "success" ? Tokens.state-success : (root.kind == "warning" ? Tokens.state-warning : (root.kind == "error" ? Tokens.state-error : (root.kind == "processing" ? Tokens.state-processing : Tokens.state-info)));
    spacing: Tokens.space-unit;
    height: 24px;
    accessible-role: AccessibleRole.text;
    accessible-label: root.label;
    Image {
        source: root.kind == "success" ? @image-url("../icons/24/done.svg") : (root.kind == "warning" ? @image-url("../icons/24/warning.svg") : (root.kind == "error" ? @image-url("../icons/24/error.svg") : (root.kind == "processing" ? @image-url("../icons/24/loading.svg") : @image-url("../icons/24/info.svg"))));
        width: 18px;
        height: 18px;
        y: (parent.height - self.height) / 2;
        colorize: root.tint;
    }
    Label { role: "label"; text: root.label; vertical-alignment: center; color: root.tint; wrap: no-wrap; overflow: elide; }
}

// A short bar that leaves by itself, with an optional action (Undo) (shell spec §2, conventions
// §5). The caller removes it after its time.
export component Toast inherits Rectangle {
    in property <string> text;
    in property <string> action;
    in property <float> unit: 1.0;
    callback acted();
    height: 48px;
    border-radius: Blueprint.on ? 0 : Tokens.radius-control;
    background: Blueprint.on ? Blueprint.paper.with-alpha(0.94) : Tokens.surface-raised;
    border-width: Blueprint.on ? 1px : 0;
    border-color: Tokens.state-info.with-alpha(0.7);
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    HorizontalLayout {
        padding-left: Tokens.space-margin;
        padding-right: root.action == "" ? Tokens.space-margin : 0;
        Label { role: "body"; text: root.text; vertical-alignment: center; horizontal-stretch: 1; wrap: no-wrap; overflow: elide; }
        if root.action != "": Button { label: root.action; unit: root.unit; clicked => { root.acted(); } border-width: 0; quiet: true; }
    }
}

// A label at the screen's edge beside a physical control, saying what it does here when that is
// not its usual job (§8.1).
export component EdgeLabel inherits Rectangle {
    in property <string> text;
    in property <string> edge: "left";
    height: 22px;
    width: label.preferred-width + 12px;
    border-radius: Blueprint.on ? 0 : 11px;
    background: Blueprint.on ? Blueprint.paper : Tokens.surface-raised;
    border-width: 1px;
    border-color: Blueprint.on ? Blueprint.interactive : Tokens.border-strong;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    label := Text {
        x: 6px;
        height: parent.height;
        vertical-alignment: center;
        text: root.text;
        font-family: Tokens.font-family-ui;
        font-size: Tokens.font-size-caption;
        color: Ink.text;
    }
}

// —— Containers and screen states ——————————————————————————————————————————————————————————

// A tonal panel (§10.2, §15): graphite, consistent radius, no card inside a card.
export component Panel inherits Rectangle {
    border-radius: Tokens.radius-card;
    background: Blueprint.on ? transparent : Tokens.surface-base;
    border-width: Blueprint.on ? 1px : 0;
    border-color: Blueprint.ink.with-alpha(Blueprint.outline);
    @children
}

// The empty state (ADR 0003): what is empty, how to fill it, at most one action.
export component EmptyState inherits VerticalLayout {
    in property <image> icon;
    in property <string> title;
    in property <string> hint;
    in property <string> action;
    in property <float> unit: 1.0;
    callback acted();
    spacing: Tokens.space-unit;
    alignment: start;
    // A fixed-width icon in a row aligned to the start: alone in the column it would cap the
    // column's width (ui-model §6).
    HorizontalLayout { alignment: start; Image { source: root.icon; width: 32px; height: 32px; colorize: Ink.muted; } }
    Rectangle { height: Tokens.space-unit; }
    Text { text: root.title; font-family: Tokens.font-family-ui; font-size: Tokens.font-size-body-large; color: Ink.text; wrap: word-wrap; }
    Label { role: "body"; muted: true; text: root.hint; }
    if root.action != "": Rectangle { height: Tokens.space-group; }
    // Its action takes the focus on entry (always present, so the focus can be forwarded to it;
    // without an action it has no size and is skipped).
    forward-focus: action-button;
    action-button := Button {
        label: root.action;
        unit: root.unit;
        visible: root.action != "";
        enabled: root.action != "";
        height: root.action != "" ? Tokens.size-target-min : 0;
        clicked => { root.acted(); }
    }
}

// The error state (ADR 0003): icon and words (never colour alone), what failed and why, the
// next step and one action that takes it. It replaces the content, so it never looks like loading.
export component ErrorState inherits VerticalLayout {
    in property <string> title;
    in property <string> reason;
    in property <string> action: "Try again";
    in property <float> unit: 1.0;
    callback acted();
    spacing: Tokens.space-unit;
    alignment: start;
    accessible-role: AccessibleRole.text;
    accessible-label: root.title + ". " + root.reason;
    // A fixed-width icon in a row aligned to the start: alone in the column it would cap the
    // column's width (ui-model §6).
    HorizontalLayout { alignment: start; Image { source: @image-url("../icons/24/error.svg"); width: 32px; height: 32px; colorize: Tokens.state-error; } }
    Rectangle { height: Tokens.space-unit; }
    Text { text: root.title; font-family: Tokens.font-family-ui; font-size: Tokens.font-size-body-large; color: Ink.text; wrap: word-wrap; }
    Label { role: "body"; muted: true; text: root.reason; }
    if root.action != "": Rectangle { height: Tokens.space-group; }
    if root.action != "": Button { label: root.action; unit: root.unit; clicked => { root.acted(); } }
}

// ── Layers and groups (ui-model §9) ─────────────────────────────────────────────────────────────

// Elements that belong together: the side margins, an optional title, and a state that cascades.
// Disabled, everything in it dims to 45 % and its touches stop at the group, so no child can act
// or re-enable itself inside it; Action and Enter stop there too, while the focus can still reach
// the children to read them (ADR 0003); its reason shows once, under the title. It creates no
// stacking context: children keep their order. Its box is their local origin.
export component Group inherits Rectangle {
    in property <string> title;
    in property <bool> enabled: true;
    // Why it is disabled, shown once (ADR 0003).
    in property <string> reason;
    in property <float> unit: 1.0;
    // Side margins belong to groups (§15.2), so a list under them runs the full width.
    in property <length> inset: Tokens.space-margin;
    accessible-role: groupbox;
    accessible-label: root.title;
    accessible-enabled: root.enabled;
    accessible-description: root.enabled ? "" : root.reason;
    VerticalLayout {
        spacing: Tokens.space-unit;
        padding-left: root.inset;
        padding-right: root.inset;
        if root.title != "": Label { role: "caption"; muted: true; text: root.title; }
        if !root.enabled && root.reason != "": Label { role: "caption"; text: root.reason; }
        FocusScope {
            focus-on-tab-navigation: false;
            focus-on-click: false;
            // Disabled: Action and Enter stop here on their way down, before any child.
            capture-key-pressed(e) => {
                if root.enabled || !FocusVisible.on { return reject; }
                if e.text == Key.Tab || e.text == Key.Backtab || e.text == Key.Escape { return reject; }
                accept
            }
            // Its children take its `enabled` explicitly (Slint has no inherited context, ui-model
            // §6.3): each dims itself and leaves the focus chain, so the group does not dim them
            // twice. It still stops their keys and touches, should one be left enabled.
            VerticalLayout {
                spacing: Tokens.space-unit;
                @children
            }
        }
    }
    // Disabled: the touches meant for its children stop at the group.
    if !root.enabled: TouchArea { pointer-event(e) => { if e.kind == PointerEventKind.down { FocusVisible.on = false; } } }
    if Blueprint.on: Rectangle {
        border-width: 1px;
        border-color: Blueprint.ink.with-alpha(Blueprint.faint);
    }
}

// A band of a screen above the content (a sticky header, the playing strip): declared after the
// content, so it draws and takes touches above it, in one order. `hit` says what its empty parts
// do with a touch: `self` takes it, `through` lets it reach what is below. Nothing invisible
// takes touches: hide a layer with `visible: false`, never with opacity.
export component Layer inherits Rectangle {
    in property <string> hit: "through";
    in property <string> name: "raised";
    if root.hit == "self": TouchArea { pointer-event(e) => { if e.kind == PointerEventKind.down { FocusVisible.on = false; } } }
    @children
    if Blueprint.on: Rectangle {
        border-width: 1px;
        border-color: Tokens.state-info.with-alpha(0.5);
        Text {
            x: 4px;
            y: 2px;
            text: root.name;
            font-family: Tokens.font-family-mono;
            font-size: 10px;
            color: Tokens.state-info;
        }
    }
}

// A popover anchored where it is declared: it opens above everything of the activity (Slint's
// popup: outside its parent's clipping and order, as the web's top layer), takes the focus while
// open (Tab and the volume buttons stay inside it) and gives it back when it closes; a touch
// outside it closes it. Open with `show()`.
export component Overlay inherits PopupWindow {
    in property <float> unit: 1.0;
    callback dismissed();
    close-policy: close-on-click-outside;
    // Escape (and the way back) closes it: a faceplate without touch is never trapped in it.
    FocusScope {
        focus-on-tab-navigation: false;
        focus-on-click: false;
        capture-key-pressed(e) => {
            if e.text == Key.Tab || e.text == Key.Backtab {
                FocusNav.backward = e.text == Key.Backtab || e.modifiers.shift;
            }
            reject
        }
        key-pressed(e) => {
            if e.text == Key.Escape { root.close(); root.dismissed(); return accept; }
            reject
        }
        Panel {
            border-width: 1px;
            border-color: Blueprint.on ? Blueprint.interactive.with-alpha(0.6) : Tokens.border-strong;
            background: Blueprint.on ? Blueprint.paper : Tokens.surface-raised;
            // Touches on the panel's own parts stay in it.
            TouchArea {}
            VerticalLayout {
                padding: Tokens.space-unit;
                @children
            }
        }
    }
}

// The dimmed ground under a modal: it takes every touch below it.
export component Scrim inherits Rectangle {
    callback tapped();
    background: Blueprint.on ? Blueprint.paper.with-alpha(0.7) : #000000b8;
    TouchArea { clicked => { root.tapped(); } }
    // In blueprint, hatched: the area is inert, not empty.
    if Blueprint.on: Rectangle {
        clip: true;
        for i in ceil(root.width / 16px) + 1: Rectangle {
            x: i * 16px;
            width: 1px;
            background: Blueprint.ink.with-alpha(Blueprint.faint * 0.6);
        }
    }
}

// A dialog: the rest of the activity is inert under a scrim (it takes every touch), the focus is
// trapped inside it (Slint's popup keeps Tab and the volume buttons in it), and Escape or a tap on
// the scrim dismiss it where `dismissable`. Its content takes the focus on entry as a screen does:
// its primary action, else its first element. Open with `show()`, close with `close()`. Declared
// at the screen's root, so it covers the whole surface.
export component Modal inherits PopupWindow {
    in property <string> title;
    in property <bool> dismissable: true;
    in property <float> unit: 1.0;
    // Its primary action (a dialog's confirm): Action with the focus hidden takes it, as a
    // screen's does.
    in property <bool> has-primary;
    callback primary();
    callback dismissed();
    close-policy: no-auto-close;
    x: 0;
    y: 0;
    Scrim {
        tapped => { if root.dismissable { root.close(); root.dismissed(); } }
    }
    FocusScope {
        focus-on-tab-navigation: false;
        focus-on-click: false;
        capture-key-pressed(e) => {
            if e.text == Key.Tab || e.text == Key.Backtab {
                FocusNav.backward = e.text == Key.Backtab || e.modifiers.shift;
            }
            reject
        }
        key-pressed(e) => {
            if e.text == Key.Escape && root.dismissable { root.close(); root.dismissed(); return accept; }
            if e.text == Key.Return || e.text == " " {
                if root.has-primary && !FocusVisible.on { root.primary(); } else { FocusVisible.on = true; }
                return accept;
            }
            reject
        }
        Panel {
            // Touches inside the dialog never reach the scrim (which dismisses).
            TouchArea { pointer-event(e) => { if e.kind == PointerEventKind.down { FocusVisible.on = false; } } }
            x: Tokens.space-margin;
            width: parent.width - 2 * Tokens.space-margin;
            height: body.preferred-height;
            y: (parent.height - self.height) / 2;
            accessible-role: groupbox;
            accessible-label: root.title;
            background: Blueprint.on ? Blueprint.paper : Tokens.surface-raised;
            border-width: 1px;
            border-color: Blueprint.on ? Blueprint.interactive.with-alpha(0.6) : Tokens.border-base;
            body := VerticalLayout {
                padding: Tokens.space-group;
                spacing: Tokens.space-group;
                if root.title != "": Label { role: "title"; text: root.title; }
                @children
            }
        }
    }
}

// ── Layout (ui-model §6) ─────────────────────────────────────────────────────────────────────────

// A vertical stack whose gap is a proximity token (DS-017): `unit` within a unit, `group` within
// a group, `section` between groups. The container owns the space; no child spaces itself.
export component Stack inherits VerticalLayout {
    in property <string> space: "group";
    spacing: root.space == "unit" ? Tokens.space-unit : (root.space == "section" ? Tokens.space-section : Tokens.space-group);
    alignment: start;
}

// A horizontal stack, as `Stack`; its start and end follow the layout's direction.
export component Row inherits HorizontalLayout {
    in property <string> space: "group";
    spacing: root.space == "unit" ? Tokens.space-unit : (root.space == "section" ? Tokens.space-section : Tokens.space-group);
}

// Items of their own size that continue on the next line (chips, format badges): a few dozen at
// most, since it is not virtualized.
export component Wrap inherits FlexboxLayout {
    in property <string> space: "unit";
    property <length> gap: root.space == "group" ? Tokens.space-group : Tokens.space-unit;
    spacing-horizontal: root.gap;
    spacing-vertical: root.gap;
}

// A label and its value, side by side when the space it is given reaches `needs`, the value
// under the label when not (SwiftUI's ViewThatFits for the commonest case: a setting's value
// beside its label, or under a long one). It decides from `available`, the width its container
// gives (bind it to the container's width), never from its own width. Two fixed layouts, one
// shown: a FlexboxLayout whose direction follows a width loops in Slint 1.18 (ui-model §6.3).
export component AdaptivePair inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <length> available;
    in property <length> needs: 280px;
    out property <bool> as-row: root.available >= root.needs;
    height: root.as-row ? beside.preferred-height : under.preferred-height;
    accessible-role: AccessibleRole.text;
    accessible-label: root.label + ": " + root.value;
    beside := HorizontalLayout {
        visible: root.as-row;
        spacing: Tokens.space-group;
        Label { role: "label"; text: root.label; horizontal-stretch: 1; wrap: no-wrap; overflow: elide; vertical-alignment: center; }
        Label { role: "label"; muted: true; text: root.value; horizontal-stretch: 0; wrap: no-wrap; vertical-alignment: center; }
    }
    under := VerticalLayout {
        visible: !root.as-row;
        spacing: Tokens.space-unit;
        Label { role: "label"; text: root.label; }
        Label { role: "label"; muted: true; text: root.value; }
    }
}

// A box whose height follows its width by a ratio (a cover: 1), so art keeps its shape at any
// width (CSS aspect-ratio). Its width comes from its container.
export component AspectBox inherits Rectangle {
    in property <float> ratio: 1;
    height: self.width * root.ratio;
    @children
}
