//
// The blueprint mode of the components (system SYS-070, blackbird-ui ADR 0002): the debug UI
// mode draws every element as a technical drawing of itself. The geometry never changes, only the
// drawing: each element keeps its size, radii and place, drawn as hairlines in ink on the
// blueprint paper, its states as strokes instead of fills. What it measures appears on demand.
//
// An application turns it on from the system's flag (`/run/opendap/debug-ui` or `ODAP_DEBUG_UI`):
// `Blueprint.on = true`.

import { Tokens } from "tokens.slint";

// The drawing's semantics, one meaning per colour and line, the same for every element and for
// the shell's references:
//   ink, hairline       structure: containers, text, dimensions
//   interactive         an area with event handlers: a button, a line, a toggle, a slider, a
//                       segment, a physical control
//   live                input on it now: pressed, touched, held
//   region (info)       the shell's regions: the status bar; and an element's measure
//   margin (warning)    the side margins, dotted
//   edge (processing)   the edge-gesture zones
export global Blueprint {
    in-out property <bool> on;
    // The paper and the ink.
    out property <color> paper: #0b2547;
    out property <color> ink: #ffffff;
    out property <color> interactive: Tokens.state-success;
    out property <color> live: Tokens.brand-base;
    // Opacity levels, from the loudest layer to the quietest.
    out property <float> text: 0.92;
    out property <float> secondary: 0.62;
    out property <float> outline: 0.38;
    out property <float> faint: 0.16;
    out property <float> fill: 0.06;
    out property <float> grid-major: 0.10;
    out property <float> grid-minor: 0.035;
}

// An element's measure, drawn over it while a pointer or a finger is on it: its box, and its
// width and height in design pixels at its top left.
export component Measure inherits Rectangle {
    in property <bool> shown;
    // Logical pixels per design pixel (the window's scale over the hardware's, as the testbed
    // calibrates it); 1 when the window's scale is the hardware's.
    in property <float> unit: 1.0;
    if root.shown && Blueprint.on: Rectangle {
        border-width: 1px;
        border-color: Tokens.state-info.with-alpha(0.8);
        Rectangle {
            x: 0;
            y: -self.height;
            width: tag.preferred-width + 6px;
            height: 14px;
            background: Blueprint.paper;
            tag := Text {
                x: 3px;
                height: parent.height;
                vertical-alignment: center;
                text: round(root.width / root.unit / 1px) + " × " + round(root.height / root.unit / 1px);
                font-family: Tokens.font-family-mono;
                font-size: 10px;
                color: Tokens.state-info;
            }
        }
    }
}

// Grid lines every `step`, at `alpha`.
export component BlueprintGrid inherits Rectangle {
    in property <length> step: 8px;
    in property <float> alpha: Blueprint.grid-minor;
    for i in floor(root.width / root.step) + 1: Rectangle {
        x: i * root.step;
        width: 1px;
        background: Blueprint.ink.with-alpha(root.alpha);
    }
    for i in floor(root.height / root.step) + 1: Rectangle {
        y: i * root.step;
        height: 1px;
        background: Blueprint.ink.with-alpha(root.alpha);
    }
}
